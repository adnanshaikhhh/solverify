# =============================================================================
# SolVerify — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (https://supabase.com — free tier)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_PROJECT_REF=your-project-ref

# -----------------------------------------------------------------------------
# Helius (https://helius.dev — free tier: 100k credits/month)
# -----------------------------------------------------------------------------
HELIUS_API_KEY=your-helius-api-key
NEXT_PUBLIC_HELIUS_RPC=https://rpc.helius.xyz/?api-key=your-helius-api-key

# -----------------------------------------------------------------------------
# Google Safe Browsing (https://console.cloud.google.com — free: 10k req/day)
# -----------------------------------------------------------------------------
GOOGLE_SAFE_BROWSING_KEY=your-google-api-key

# -----------------------------------------------------------------------------
# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-min-64-character-random-string-please-use-openssl-rand

# -----------------------------------------------------------------------------
# Admin
# Comma-separated list of admin wallet addresses
# -----------------------------------------------------------------------------
ADMIN_WALLETS=YourAdminWalletAddress1,YourAdminWalletAddress2

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
PAYMENT_WALLET=YourSolanaReceivingWalletAddress
SILVER_PRICE_USD=30
GOLD_PRICE_USD=60

# -----------------------------------------------------------------------------
# Cron
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=replace-with-32-char-random-hex

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://solverify.vercel.app
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
